{
  "name": "studio-liddi",
  "version": "1.0.0",
  "description": "Sito dello Studio Odontoiatrico Liddi — generatore statico senza dipendenze",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "images": "node scripts/fetch-images.mjs",
    "icons": "node scripts/make-icons.mjs",
    "serve": "python3 -m http.server 4173 --directory dist",
    "dev": "npm run build && npm run serve",
    "test": "node --test \"tests/*.test.mjs\"",
    "dev:api": "node scripts/dev-api.mjs",
    "email:preview": "node scripts/anteprima-email.mjs",
    "email:conferma": "node scripts/invia-conferma.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
